{
  "name": "TourwithChe B | End-of-call report (sheet log + owner summary + follow-up queue)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "brightmove-end-of-call",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1302306b588f40f1",
      "name": "WH end-of-call report",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1000,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the Vapi end-of-call report (and ignore other server messages downstream).\nconst { DateTime } = require('luxon');\nconst ZONE = 'Europe/Berlin';\nconst body = $json.body || $json;\nconst msg = body.message || body;\nconst call = msg.call || {};\nconst analysis = msg.analysis || {};\nconst artifact = msg.artifact || {};\n\nconst messages = Array.isArray(artifact.messages) ? artifact.messages : [];\nconst transcript = (msg.transcript && String(msg.transcript).trim())\n  ? String(msg.transcript)\n  : messages.map(m => ((m.role || 'unknown') + ': ' + (m.message || m.content || '')).trim()).filter(Boolean).join('\\n');\n\nconst summary = String(msg.summary || analysis.summary || '').trim();\nconst caller = (call.customer && call.customer.number) || 'unknown';\nconst started = msg.startedAt || call.startedAt || '';\nconst ended = msg.endedAt || call.endedAt || '';\nlet durationSec = '';\nif (started && ended) {\n  durationSec = Math.max(0, Math.round((new Date(ended) - new Date(started)) / 1000));\n}\nconst blob = JSON.stringify(messages) + JSON.stringify(msg.toolCalls || []) + JSON.stringify(msg.toolCallResults || []);\nconst booked = blob.indexOf('Booked:') !== -1;\nconst callback = blob.indexOf('requestCallback') !== -1;\nconst outcome = booked ? 'booked' : (callback ? 'callback requested' : 'no booking');\n\nconst now = DateTime.now().setZone(ZONE);\nconst date = now.toISODate();\nconst time = now.toFormat('HH:mm');\nconst followUpDate = now.plus({ days: 1 }).toISODate();\nconst shortTranscript = transcript.split('\\n').slice(0, 12).join('\\n');\n\nreturn [{ json: {\n  type: msg.type || '',\n  caller, durationSec, outcome, summary, shortTranscript,\n  date, time, followUpDate\n}}];"
      },
      "id": "a38c6b1cbf834de5",
      "name": "Parse call report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -780,
